@model List<ESTA.Areas.Admin.Models.CertifiedMember>

@using Microsoft.Extensions.Localization
@using System.Globalization

<style>
    .certified-mem {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        border-bottom: 0.2px solid #80808036
    }
</style>
@inject IStringLocalizer<SharedResource> localizer;
<div class="slider-area">
    <div class="page-title">
        <div class="single-slider slider-height slider-height-breadcrumb d-flex align-items-center" style="background-image: url(@Url.Content("~/template/img/inner-bg.png") );">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="slider-content slider-content-breadcrumb text-center">
                            <h1 class="white-color f-700">@localizer["cetaholders"]</h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    @*  <p style="padding:40px" sty>  @localizer["notfound"]</p>*@
}
<p style="padding:20px 40px"> **@localizer["MembersOrder"] </p>
<br />
<div class="card col-md-6" style="margin: auto;">
    <ul class="list-group list-group-flush">

        @foreach (var item in Model)
        {
            <li class="list-group-item">
                <span class="ti-user" style="font-size:30px;margin: 10px;"></span>
                <span class="h5" style="font-weight:600">@item.Name</span>
            </li>
        }
    </ul>
</div>
