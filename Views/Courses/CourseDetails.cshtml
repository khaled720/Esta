@using System.Globalization
@using ESTA.Helpers
@using ESTA.Repository.IRepository
@using Microsoft.AspNetCore.Identity
@inject IUnitOfWork uow
@inject IHttpContextAccessor accessor
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ESTA.ViewModels.CourseDetailsViewModel
@using Microsoft.Extensions.Localization
@using System.Security.Claims


@inject SignInManager<User> signInManager;
<!--This View For User-->
@if (Model != null)
{
    <div id="choice" style="z-index:2; display:none;backdrop-filter:blur(5px);position:absolute;
    top:0;bottom:0;right:0;left:0 ">


        <div style="z-index: 100000;background: white;
        padding: 32px;left: 30%;top: 30%;position: sticky;width: 50%;
        border: 0.5px gray solid;border-radius: 15px;">

            <p>@localizer["coursepopup"] </p>

            @if (!await uow.UserRep.IsForeignUser(Model.userid)
                    && Model.course.StartDate != null
                    && (Model.course.StartDate - DateTime.Now).Value.Days >= 0)
            {

                <a asp-action="PayEnrollCourse" asp-controller="User"
                   asp-route-id="@Model.course.Id" asp-route-level="@Model.course.LevelId"
                   class="btn btn-danger"> @localizer["paynow"]</a>

            }
            else
            {

                @if (await uow.UserRep.IsForeignUser(Model.userid)
                        && Model.course.StartDate != null
                        //&& (Model.StartDate - DateTime.Now).Value.Days < 0
                        && (Model.course.StartDate - DateTime.Now).Value.Days < 10
                        )
                {

                    <p class="text-danger">Enrollment Not Available right now ,If you want to register <a class="btn btn-primary" asp-controller="Home" asp-action="Contact" asp-area="">Contact Us</a></p>

                }

            }


            @if (Model.course.StartDate != null && (Model.course.StartDate - DateTime.Now).Value.Days >= 10)
            {

                <a id="enroll" asp-action="EnrollCourse" asp-controller="User"
                   asp-route-Id="@Model.course.Id" asp-route-level="@Model.course.LevelId"
                   class="btn btn-warning"> @localizer["paylater"]</a>

            }



            <a onclick="HideEnrollOptions()" href="#" class=""> @localizer["cancel"]</a>

        </div>

    </div>
}




<div class="slider-area">
    <div class="pages-title">
        <div class="single-slider slider-height slider-height-breadcrumb d-flex align-items-center" style="background-image: url(@Url.Content("~/template/img/inner-bg.png"));">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="slider-content slider-content-breadcrumb text-center">
                            <h1 class="white-color f-700">@localizer["coursedetails"]</h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- slider-end -->
<div class="course-details-are pt-50 pb-50 ar">
    <div class="container">
        @if (Model != null)
        {
            <div class="row">
                <div class="col-xl-12 col-lg-12">
                    <div class="single-course-details-area mb-30">
                        <div class="course-details-thumb text-center">
                            <img src="@Url.Content("~" + @Model.course.PhotoPath)" alt="">
                        </div>
                        <div class="single-course-details white-bg">
                            <div class="course-details-title mb-20" style="display:flex;justify-content:space-between">
                                <h1>
                                    @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                    {
                                        @Model.course.TitleAr
                                    }
                                    else
                                    {
                                        @Model.course.Title
                                    }
                                </h1>

                                <h4 class="text-danger">

                                    @if (Model.course.Price <= 0)
                                    {
                                        @localizer["free"]
                                    }
                                    else
                                    {
                                        @Model.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))
                                    }
                                </h4>
                            </div>
                            <div class="course-details-tabs">
                                <ul class="nav nav-pills" id="pills-tab" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="pills-home-tab" data-toggle="pill" href="#pills-home" role="tab" aria-controls="pills-home" aria-selected="true">@localizer["overview"]</a>
                                    </li>
                                </ul>
                                <div class="tab-content" id="pills-tabContent">
                                    <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab">
                                        <div class="course-details-overview-top">
                                            <p class="course-details-overview-para">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @Model.course.DescriptionAr
                                                }
                                                else
                                                {
                                                    @Model.course.Description
                                                }

                                            </p>
                                        </div>

                                        @if (Model.PrerequisiteCourses.Count > 0)
                                        {
                                            <a class="nav-item nav-link " id="pills-home-tab">@localizer["prereq"]</a>
                                            <div id="courses-grid" style="display:grid;gap:15px; grid-template-columns:1fr 1fr 1fr 1fr ">

                                                @foreach (var item in Model.PrerequisiteCourses)
                                                {
                                                    <a asp-action="coursedetails" asp-controller="courses" asp-area="" asp-route-id="@item.prerequisiteCourse.Id">
                                                        <div class="card" style="height:fit-content; position:relative">
                                                            @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>*@
                                                            <div class="card-header" style="position:absolute;top:0;left:0;right:0;background: rgba(100%,100%,100%,50%);backdrop-filter: blur(5px);">
                                                                <h5>
                                                                    @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                                    {
                                                                        @item.prerequisiteCourse.TitleAr
                                                                    }
                                                                    else
                                                                    {
                                                                        @item.prerequisiteCourse.Title
                                                                    }

                                                                </h5>
                                                            </div>
                                                            <img src="@Url.Content("~" + @item.prerequisiteCourse.PhotoPath) " height="200px" />

                                                            <div class="card-body">
                                                                @localizer["stdate"]:@item.prerequisiteCourse.StartDate.Value.ToShortDateString()
                                                                <br>

                                                                <br>@localizer["price"]: <strong style="color:green"> @item.prerequisiteCourse.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                                                                @if (item.isPassed)
                                                                {
                                                                    <strong style="color:green">  @localizer["enrolled"] </strong>
                                                                }
                                                                else
                                                                {
                                                                    <strong style="color:red">  @localizer["notenrolled"] </strong>
                                                                }
                                                            </div>
                                                        </div>
                                                    </a>
                                                }
                                            </div>
                                        }

                                        <div class="course-details-overview-bottom d-flex justify-content-between mt-25">
                                            <div class="course-overview-info-left">
                                                <div class="course-overview-student-lecture mt-10">
                                                    <span class="primary-color">@localizer["level"] : <span class="gray-color">@Model.course.level.TypeName</span></span>
                                                    <span class="student-lecture-number primary-color">@localizer["stdate"]: <span class="gray-color">@Model.course.StartDate.Value.ToString("yyyy/MM/dd")</span></span>
                                                    @if (Model.course.FinalGrade <= 0)
                                                    {
                                                        <span class="student-lecture-number gray-color">*@localizer["coursehint"]</span>
                                                    }

                                                </div>
                                            </div>
                                        </div>

                                        @if (Model.course.StartDate != null && Model.course.StartDate.Value.Date > DateTime.Now.Date)
                                        {
                                            @if (signInManager.IsSignedIn(User))
                                            {
                                                if (!Model.isCompleted)
                                                {
                                                    if (Model.isCourseEnrolled)
                                                    {
                                                        if (!Model.IsCourseRefunded)
                                                        {
                                                            <h4 class="text-danger">@localizer["haveenrolled"]</h4>

                                                            <a class="btn btn-info" asp-action="Create"
                                                               asp-controller="Refund"
                                                               asp-area="Payment" asp-route-CourseId="@Model.course.Id">@localizer["refund"]</a>
                                                        }
                                                        else
                                                        {
                                                            if (Model.IsMempershipPaid)
                                                            {
                                                                @if (Model.IsPrerequisiteCoursesPassed)
                                                                {
                                                                    <a class="vissionMissionBtn theme-btn blue-bg-border mt-30" onclick="ShowEnrollOptions()">
                                                                        <span class="btn-text bg-red">@localizer["join"]</span>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <h4 class="text-danger">@localizer["preinc"]</h4>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <h4 class="text-danger">@localizer["memnotpaid"]</h4>
                                                                <a class="btn btn-info" asp-action="ConfirmMembershipOrder"
                                                                   asp-controller="Orders"
                                                                   asp-area="Payment">@localizer["paymem"]</a>
                                                            }
                                                        }
                                                    }
                                                    else
                                                    {
                                                        if (Model.UsersEnrolledCount < Model.course.MaxAllowedMembersCount)
                                                        {
                                                            if (Model.IsMempershipPaid)
                                                            {
                                                                @if (Model.IsPrerequisiteCoursesPassed)
                                                                {
                                                                    <a class="vissionMissionBtn theme-btn blue-bg-border mt-30" onclick="ShowEnrollOptions()">
                                                                        <span class="btn-text bg-red">@localizer["join"]</span>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <h4 class="text-danger">@localizer["preinc"]</h4>
                                                                }
                                                                @* <a class="vissionMissionBtn theme-btn blue-bg-border mt-30" onclick="ShowEnrollOptions()">
                                        <span class="btn-text bg-red">@localizer["join"]</span>
                                        </a> *@
                                                            }
                                                            else
                                                            {
                                                                <h4 class="text-danger">@localizer["memnotpaid"]</h4>
                                                                <a class="btn btn-info" asp-action="ConfirmMembershipOrder"
                                                                   asp-controller="Orders" asp-area="Payment">@localizer["paymem"]</a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <h4 class="text-danger">@localizer["coursecomplete"]</h4>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <strong style="color:green">  @localizer["completedCourse"] </strong>
                                                }
                                            }
                                            else
                                            {
                                                <a class="vissionMissionBtn theme-btn blue-bg-border mt-30" asp-controller="Account" asp-action="Register">
                                                    <span class="btn-text bg-red">@localizer["join"]</span>
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p>@localizer["notfound"]</p>
        }

    </div>
</div>


<script>
    function ShowEnrollOptions() {
        var div = document.getElementById("choice");
        div.style.display = "block";
    }

    function HideEnrollOptions() {
        var div = document.getElementById("choice");
        div.style.display = "none";
    }

</script>