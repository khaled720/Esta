@model IEnumerable<ESTA.Models.UserCourse>

@{
    ViewData["Title"] = "_results";
}

@*<h1>_results</h1>*@
<div class="row justify-content-center" style="gap:5px">
    @if (Model.Count() > 0)
    {
        @foreach (var item in Model)
        {
            <div class="col-sm-5 p-0">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="bio-chart">
                            @if (item.StateId == 3)
                            {
                                <span class="knob"
                                      style="
                  display: inline-block;
                  width: 100px;
                  height: 100px;
                  border-radius: 50%;
                  background: conic-gradient(#96be4b 0 @((item.Grade*item.course.FinalGrade)/100)%, #e8e8e8 @((item.Grade*item.course.FinalGrade)/100)% 100%);
                  position: relative;
                  line-height: 100px;
                  text-align: center;
                  font-size: 20px;
                  color: black;
                  font-weight: bold;">
                                    @item.Grade
                                </span>
                            }
                            else
                            {
                                <span class="knob"
                                      style="
                  display: inline-block;
                  width: 100px;
                  height: 100px;
                  border-radius: 50%;
                  background: conic-gradient(#e06b7d 0 @(item.Grade*item.course.FinalGrade/100)%, #e8e8e8 @(item.Grade*item.course.FinalGrade/100)% 100%);
                  position: relative;
                  line-height: 100px;
                  text-align: center;
                  font-size: 20px;
                  color: black;
                  font-weight: bold;">
                                    @item.Grade
                                </span>
                            }

                        </div>
                        <div class="bio-desk">
                            <h5 class="text-info">@item.course.Title</h5>
                            <p>
                                <strong>@localizer["state"]:</strong>
                                @if ((item.Grade * item.course.FinalGrade / 100) >= item.course.SuccessPersentage)
                                {
                                    <span class="text-success"> @localizer["pass"] </span>
                                }
                                else
                                {
                                    <span class="text-danger"> @localizer["fail"] </span>
                                }
                            </p>
                            <p><strong>@localizer["enrolldate"]:</strong> @item.EnrollmentDate.ToShortDateString()</p>
                        </div>
                    </div>
                </div>
            </div>

        }
