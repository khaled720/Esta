@using System.Globalization
@using ESTA.Helpers
@model IEnumerable<UserCourse>




<div class="container">
    @if (Model.Count() == 0)
    {
        <h3 class="text-danger "> @localizer["notfound"]</h3>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />
    }
    else
    {
        <div class="accordion" id="accordionExample">
            <div class="card">
                <div class="card-header" id="headingOne">
                    <h2 class="mb-0">
                        <button class="btn btn-link btn-block text-left" type="button" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            @localizer["Latest"]
                        </button>
                    </h2>
                </div>
                <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">

                        <div id="courses-grid" style="display:grid;gap:10px; grid-template-columns:1fr 1fr 1fr ">

                            @foreach (var item in Model.Where(x => x.StateId != 3).ToList())
                            {


                                <div class="card" style="height:fit-content; position:relative">
                                    @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>
                            *@   <div class="card-header" style="
position:absolute;top:0;left:0;right:0;

background: rgba(100%,100%,100%,50%);
    backdrop-filter: blur(5px);">
                                        <h5>


                                            <a asp-action="coursedetails" asp-controller="courses" asp-area="" asp-route-id="@item.course.Id">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @item.course.TitleAr
                                                }
                                                else
                                                {
                                                    @item.course.Title
                                                }
                                            </a>
                                        </h5>
                                    </div>
                                    <img src="@Url.Content("~"+@item.course.PhotoPath) " width="100%" height="200px" />


                                    <div class="card-body">
                                        @localizer["stdate"]:    @item.course.StartDate.Value.ToShortDateString()
                                        <br>
                                        @localizer["enrolldate"]:    @item.EnrollmentDate.ToShortDateString()

                                        <br> @localizer["state"]:@item.state.StateName

                                        <br>  @localizer["price"]: <strong style="color:green"> @item.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                                        @*         <br>  @localizer["state"]: <strong style="color:green"> @item.state.StateName</strong>*@

                                        <br> @localizer["paystate"]:
                                        @if (item.isPaid)
                                        {
                                            <strong style="color:green">  @localizer["done"] </strong>
                                        }
                                        else
                                        {

                                            <strong style="color:green">  @localizer["pending"] </strong>
                                            @if (item.course.StartDate >= DateTime.Now)
                                            {
                                                <br />
                                                <a asp-action="PayEnrollCourse" asp-controller="User"
                                                   asp-route-id="@item.course.Id" asp-route-level="@item.course.LevelId"
                                                   class="btn btn-danger"> @localizer["paynow2"]</a>
                                            }
                                        }

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header" id="headingTwo">
                    <h2 class="mb-0">
                        <button class="btn btn-link btn-block text-left collapsed" type="button" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            @localizer["Previous"]
                        </button>
                    </h2>
                </div>

                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionExample">
                    <div class="card-body">

                        <div id="courses-grid" style="display:grid;gap:10px; grid-template-columns:1fr 1fr 1fr ">

                            @foreach (var item in Model.Where(x => x.StateId == 3).ToList())
                            {


                                <div class="card" style="height:fit-content; position:relative">
                                    @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>
                            *@   <div class="card-header" style="
position:absolute;top:0;left:0;right:0;

background: rgba(100%,100%,100%,50%);
    backdrop-filter: blur(5px);">
                                        <h5>


                                            <a asp-action="coursedetails" asp-controller="courses" asp-area="" asp-route-id="@item.course.Id">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @item.course.TitleAr
                                                }
                                                else
                                                {
                                                    @item.course.Title
                                                }
                                            </a>
                                        </h5>
                                    </div>
                                    <img src="@Url.Content("~"+@item.course.PhotoPath) " width="100%" height="200px" />


                                    <div class="card-body">
                                        @localizer["stdate"]:    @item.course.StartDate.Value.ToShortDateString()
                                        <br>
                                        @localizer["enrolldate"]:    @item.EnrollmentDate.ToShortDateString()

                                        <br> @localizer["state"]:@item.state.StateName

                                        <br>  @localizer["price"]: <strong style="color:green"> @item.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                                        @*         <br>  @localizer["state"]: <strong style="color:green"> @item.state.StateName</strong>*@

                                        <br> @localizer["paystate"]:
                                        @if (item.isPaid)
                                        {
                                            <strong style="color:green">  @localizer["done"] </strong>
                                        }
                                        else
                                        {

                                            <strong style="color:green">  @localizer["pending"] </strong>
                                            @if (item.course.StartDate >= DateTime.Now)
                                            {
                                                <br />
                                                <a asp-action="PayEnrollCourse" asp-controller="User"
                                                   asp-route-id="@item.course.Id" asp-route-level="@item.course.LevelId"
                                                   class="btn btn-danger"> @localizer["paynow2"]</a>
                                            }
                                        }

                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

    }

    <style>
        .card {
            transition: 0.5s ease-in-out;
            overflow: hidden;
            /*z-index:10;
                                                                                */
        }

            .card:hover {
                transform: translateY(-5px);
            }

    </style>
