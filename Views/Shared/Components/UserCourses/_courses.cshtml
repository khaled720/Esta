@using System.Globalization
@using ESTA.Helpers
@model IEnumerable<UserCourse>




<div class="container">
    @if (Model.Count() == 0)
    {
        <h3 class="text-danger "> @localizer["notfound"]</h3>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />
    }
    else
    {
        <div class="accordion" id="accordionExample">
            <div class="card">
                <div class="card-header p-0" id="headingOne">
                    <button class="btn btn-block" type="button" style="padding:.75rem 1.25rem" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        @localizer["Latest"]
                    </button>
                </div>
                <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordionExample">
                    <div class="card-body">

                        <div id="courses-grid" style="display:grid;gap:10px; grid-template-columns:1fr 1fr 1fr ">

                            @foreach (var item in Model.Where(x => x.StateId == 1 || x.StateId == 2).ToList())
                            {


                                <div class="card" style="height:fit-content; position:relative">
                                    @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>
                            *@   <div class="card-header" style="
position:absolute;top:0;left:0;right:0;

background: rgba(100%,100%,100%,50%);
    backdrop-filter: blur(5px);">
                                        <h5>


                                            <a asp-action="coursedetails" asp-controller="courses" asp-area="" asp-route-id="@item.course.Id">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @item.course.TitleAr
                                                }
                                                else
                                                {
                                                    @item.course.Title
                                                }
                                            </a>
                                        </h5>
                                    </div>
                                    <img src="@Url.Content("~"+@item.course.PhotoPath) " width="100%" height="200px" />


                                    <div class="card-body">
                                        <strong>  @localizer["stdate"]: </strong>   @item.course.StartDate.Value.ToShortDateString()
                                        <br>
                                        <strong>
                                            @localizer["enrolldate"]:
                                        </strong>    @item.EnrollmentDate.ToShortDateString()

                                        <br>  <strong>
                                            @localizer["state"]:
                                        </strong>@item.state.StateName

                                        <br>   <strong>
                                            @localizer["price"]:
                                        </strong> <strong style="color:green"> @item.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                                        @*         <br>  @localizer["state"]: <strong style="color:green"> @item.state.StateName</strong>*@

                                        <br>  <strong>
                                            @localizer["paystate"]:
                                        </strong>
                                        @if (item.isPaid)
                                        {
                                            <strong style="color:green">  @localizer["done"] </strong>
                                        }
                                        else
                                        {

                                            <strong style="color:green">  @localizer["pending"] </strong>
                                            @if (item.course.StartDate >= DateTime.Now)
                                            {
                                                <br />
                                                <a asp-action="PayEnrollCourse" asp-controller="User"
                                                   asp-route-id="@item.course.Id" asp-route-level="@item.course.LevelId"
                                                   class="btn btn-danger"> @localizer["paynow2"]</a>
                                            }
                                        }

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header p-0" id="headingTwo">
                    <button class="btn btn-block collapsed" style="padding:.75rem 1.25rem" type="button" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        @localizer["Previous"]
                    </button>
                </div>

                <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionExample">
                    <div class="card-body">

                        <div id="courses-grid" style="display:grid;gap:10px; grid-template-columns:1fr 1fr 1fr ">

                            @foreach (var item in Model.Where(x => x.StateId != 1 && x.StateId != 2).ToList())
                            {


                                <div class="card" style="height:fit-content; position:relative">
                                    @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>
                            *@   <div class="card-header" style="
position:absolute;top:0;left:0;right:0;

background: rgba(100%,100%,100%,50%);
    backdrop-filter: blur(5px);">
                                        <h5>


                                            <a asp-action="coursedetails" asp-controller="courses" asp-area="" asp-route-id="@item.course.Id">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @item.course.TitleAr
                                                }
                                                else
                                                {
                                                    @item.course.Title
                                                }
                                            </a>
                                        </h5>
                                    </div>
                                    <img src="@Url.Content("~"+@item.course.PhotoPath) " width="100%" height="200px" />


                                    <div class="card-body">
                                        <strong>  @localizer["stdate"]: </strong>   @item.course.StartDate.Value.ToShortDateString()
                                        <br>
                                        <strong>
                                            @localizer["enrolldate"]:
                                        </strong>    @item.EnrollmentDate.ToShortDateString()

                                        <br>
                                        <span>
                                            <strong>
                                                @localizer["state"]:
                                            </strong> @item.state.StateName
                                        </span>

                                        <br>   <strong>
                                            @localizer["price"]:
                                        </strong> <strong style="color:green"> @item.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                                        @*         <br>  @localizer["state"]: <strong style="color:green"> @item.state.StateName</strong>*@

                                        <br>  <strong>
                                            @localizer["paystate"]:
                                        </strong>
                                        @if (item.isPaid)
                                        {
                                            <strong style="color:green">  @localizer["done"] </strong>
                                        }
                                        else
                                        {

                                            <strong style="color:green">  @localizer["pending"] </strong>
                                            @if (item.course.StartDate >= DateTime.Now)
                                            {
                                                <br />
                                                <a asp-action="PayEnrollCourse" asp-controller="User"
                                                   asp-route-id="@item.course.Id" asp-route-level="@item.course.LevelId"
                                                   class="btn btn-danger"> @localizer["paynow2"]</a>
                                            }
                                        }

                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

    }
</div>
<style>
    .card {
        transition: 0.5s ease-in-out;
        overflow: hidden;
        /*z-index:10;
                                                                                                                            */
    }

        .card:hover {
            transform: translateY(-5px);
        }

</style>
