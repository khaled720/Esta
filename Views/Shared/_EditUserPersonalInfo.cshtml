    </div>

    </div>*@
    <div class="form-group">
        <label asp-for="@Model.Birthdate"></label>
        <input asp-for="@Model.Birthdate" class="form-control"
               type="date" />

        <span asp-validation-for="@Model.Birthdate" class="text-danger"></span>
    </div>
    <div class="row">



        <div class="form-group col-lg-6 col-sm-12">
            <label asp-for="@Model.HomePhone"></label>
            <input asp-for="@Model.HomePhone" class="form-control"
                   autocomplete="username" />

            <span asp-validation-for="@Model.HomePhone" class="text-danger"></span>
        </div>

        <div class="form-group col-lg-6 col-sm-12">
            <label asp-for="@Model.MobilePhone"></label>
            <input asp-for="@Model.MobilePhone" class="form-control"
                   autocomplete="username" />

            <span asp-validation-for="@Model.MobilePhone" class="text-danger"></span>
        </div>



    </div>
    @*  <div class="row">



    <div class="form-group col-lg-6 col-sm-12 register-english-levels">
    <label asp-for="@Model.EnglishReadingLevel"></label>
    <br />
    <input style="width:60%" value="Good" type="radio" asp-for="@Model.EnglishReadingLevel" /> <label>@localizer["good"]</label>
