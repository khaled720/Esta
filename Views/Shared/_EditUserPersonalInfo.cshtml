@{
}

@model ESTA.ViewModels.EditUserPersonalInfoViewModel
<style>
    .uploadImg {
        background-repeat: no-repeat;
        height: 150px;
        width: 150px;
    }
</style>

<form method="post" asp-action="EditPersonalInfo" enctype="multipart/form-data" asp-controller="Users">
    @Html.HiddenFor(y => y.Id)


    <h3>Personal</h3>



    <div class="row">
        <div class="form-group col-lg-6 col-sm-12">
            <label asp-for=@Model.FullName></label>
            <input asp-for="@Model.FullName" class="form-control"
                   autocomplete="name" />

            <span asp-validation-for="@Model.FullName" class="text-danger"></span>
        </div>

        <div class="form-group col-lg-6 col-sm-12">
            <label asp-for="@Model.FullNameAr"></label>
            <input asp-for="@Model.FullNameAr" class="form-control"
                   autocomplete="name" />

            <span asp-validation-for="@Model.FullNameAr" class="text-danger"></span>
        </div>

    </div>

    <div class="form-group">
        <label asp-for="@Model.MembershipNumber"></label>
        <input asp-for="@Model.MembershipNumber" class="form-control"
               autocomplete="username" />

        @* <span asp-validation-for="@Model.MembershipNumber" class="text-danger"></span> *@
    </div>

    <div class="form-group col-4">
        <label asp-for="@Model.Country"></label>
        <select id="nationalty-select"
                onchange="checkNationality()" class="form-control" asp-for="@Model.Country">
            @foreach (var item in CultureManager.GetCountries())
            {
                if (item.NameEn == Model.Country)
                {
                    if (CultureInfo.CurrentCulture.Name == "ar")
                    {
                        <option value="@item.NameEn" selected="selected">@item.NameAr</option>
                    }
                    else
                    {
                        <option value="@item.NameEn" selected="selected">@item.NameEn</option>
                    }
                }
                else
                {
                    if (CultureInfo.CurrentCulture.Name == "ar")
                    {
                        <option value="@item.NameEn">@item.NameAr</option>
                    }
                    else
                    {
                        <option value="@item.NameEn">@item.NameEn</option>
                    }
                }
            }
        </select>

        <span asp-validation-for="@Model.Country" class="text-danger"></span>
    </div>


    <div class="">

        <div class="form-group " id="passport-sec">
            <label asp-for="@Model.Passport"></label>
            <input asp-for="@Model.Passport" class="form-control" id="passport" />

            <span asp-validation-for="@Model.Passport" class="text-danger"></span>
            <div id="img-preview0">
            </div>
            @{
                var counter = 0;
                foreach (var image in Model.userImages)
                {
                    if (image.TypeId == 2)
                    {
                        counter++;
                        //<div class="file-upload mb-3">
                        //    <div class="image-upload-wrap">
                        //        <input asp-for="PassportImages[0]" class="file-upload-input" id="img" accept="image/jpeg, image/png" type='file' onchange="readURL(this);" />
                        //        <img class="img-fluid" id="imgSrc" src="@Url.Content("~"+image.Path)" alt="your image" />
                        //    </div>
                        //</div>

                        <a href="@image.Path" target="_blank">
                            <img src="@Url.Content("~" + image.Path)" width="150" height="150" />
                        </a>

                    }

                }

                if (counter == 0)
                {
                    <p>No Passport Photos Were Found</p>
                    <input id="passportImg" asp-for="@Model.PassportImages" type="file" multiple class="form-control" />
                }
                else
                {
                    <label asp-for="@Model.PassportImages"></label>
                    <input id="passportImg" asp-for="@Model.PassportImages" type="file" multiple class="form-control" accept="image/jpeg, image/png" />
                }
                <input type="hidden" id="PassImgCnt" value="@counter" />
            }
        </div>

        <div class="form-group  " id="idCard-sec" style="display:none;">
            <label asp-for="@Model.NationalCardID"></label>

            <input id="idno" asp-for="@Model.NationalCardID" class="form-control" />

            <span asp-validation-for="@Model.NationalCardID" class="text-danger"></span>
            <div id="img-preview1">
            </div>
            @{
                var counter1 = 0;
                foreach (var image in Model.userImages)
                {
                    @if (image.TypeId == 1)
                    {
                        counter1++;
                        //<div class="file-upload mb-3">
                        //    <div class="image-upload-wrap">
                        //        <input asp-for="NationalIdImages[0]" class="file-upload-input" id="img" accept="image/jpeg, image/png" type='file' onchange="readURL(this);" />
                        //        <img class="img-fluid" id="imgSrc" src="@Url.Content("~"+image.Path)" alt="your image" />
                        //    </div>
                        //</div>
                        <a href="@image.Path" target="_blank">
                            <img src="@Url.Content("~" + image.Path)" width="150" height="150" />
                        </a>

                    }
                }

                @if (counter1 == 0)
                {
                    <p>No National Id  Were Found</p>
                    <div class=" col-12 ">
                        <label>National Card Front Image</label>
                        <span class="text-danger m-1">* Two Images Should be provided Front & Back</span>

                        <input id="idnoImg0" accept='.png,.jpg,.jpeg,.webp' asp-for="@Model.NationalCardImagesFront" type="file" />
                        <span id="idcard-err0" asp-validation-for="@Model.NationalCardImagesFront" class="text-danger"></span>

                    </div>

                    <div class=" col-12 ">
                        <label>National Card Back Image</label>

                        <input id="idnoImg1" accept='.png,.jpg,.jpeg,.webp' asp-for="@Model.NationalCardImagesBack" type="file" />
                        <span id="idcard-err1" asp-validation-for="@Model.NationalCardImagesBack" class="text-danger"></span>

                    </div>
                }
                else
                {

                    <div class=" col-12 ">
                        <label asp-for="@Model.NationalCardImagesFront"></label>

                        <input id="idnoImg0" accept='.png,.jpg,.jpeg,.webp' asp-for="@Model.NationalCardImagesFront" type="file" />
                        <span id="idcard-err0" asp-validation-for="@Model.NationalCardImagesFront" class="text-danger"></span>

                    </div>

                    <div class=" col-12 ">
                        <label asp-for="@Model.NationalCardImagesBack"></label>

                        <input id="idnoImg1" accept='.png,.jpg,.jpeg,.webp' asp-for="@Model.NationalCardImagesBack" type="file" />
                        <span id="idcard-err1" asp-validation-for="@Model.NationalCardImagesBack" class="text-danger"></span>

                    </div>
                }
                <input type="hidden" id="IdImgCnt" value="@counter1" />
            }

        </div>



    </div>

    <div class="form-group">
        <label asp-for="@Model.Email"></label>
        <input asp-for="@Model.Email" class="form-control"
               autocomplete="username" />

        <span asp-validation-for="@Model.Email" class="text-danger"></span>
    </div>
