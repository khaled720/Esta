    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using Microsoft.AspNetCore.Identity;
@using ESTA.Repository.IRepository;
@inject IUnitOfWork appRep;
@inject UserManager<User> userManager;
@inject SignInManager<User> signInManager;
@inject IStringLocalizer<SharedResource> localizer;
@model ESTA.ViewModels.RenderComment
@{
    var IsSigned = signInManager.IsSignedIn(User);
    var userId = "";
    if (IsSigned)
    {
        var user = await userManager.GetUserAsync(User);
        userId = user.Id;
    }
}

@foreach (var comment in Model.UserForums)
{
    <li id="comment@(comment.Id)" class="comment-parent">
        <div class="comments-box main-comments d-flex">
            <div class="comments-avatar">
                <img src="@Url.Content("~" + comment.userPic)" alt="" class='rounded-circle shadow-1-strong me-3' width='65' height='65'>
            </div>
            <div class="comments-text">
                <div class="avatar-name">
                    <h5>@comment.userName <span class='small'> - @comment.CreatedDate.ToString("yyyy/MM/dd hh:mm:ss tt")</span></h5>
                </div>

                <p>@comment.Comment</p>
                @if (!string.IsNullOrEmpty(comment.FilePath))
                {
                    <div class="attachment" style="display: flex;">
                        <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png" alt="PDF" />
                        <a href="@Url.Content("~/images/comments/" + comment.FilePath)" target="_blank" class="filename">@(comment.FilePath)</a>
                    </div>
                }

            </div>

        </div>

        <div class="comment-op" style="align-items: baseline;display: flex;flex-direction: row;gap: 10px;">

            @if (userId == comment.userId)
            {
                @* <form method="post" asp-action="DeleteComment" asp-route-commentId="@comment.Id" style="display:inline-block;">
                        <button type="submit" class='btn btn-danger'>Delete</button>
                    </form> *@
                <a onclick='deleteCommentUser(@comment.Id)' class='link-danger delete'>@localizer["delete"]</a>
            }
            @if (Model.showAllLink && comment.RepliesCount > 0)
            {
                <a asp-action="GetComment" asp-route-id="@comment.Id" id="repliesCountText@(comment.Id)" class="my-2">@localizer["ShowAll"] @(comment.RepliesCount) @localizer["Replies"]</a>
            }
            else
            {
                <a asp-action="GetComment" asp-route-id="@comment.Id" id="repliesCountText@(comment.Id)" class="my-2">@localizer["Reply"] </a>
            }
            <a class="secondary" href="#" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom" title="copy link to clipboard" onclick="copyToClipboard(@comment.Id)">
                Copy
                @* <svg style="width:6%" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M280 64h40c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V128C0 92.7 28.7 64 64 64h40 9.6C121 27.5 153.3 0 192 0s71 27.5 78.4 64H280zM64 112c-8.8 0-16 7.2-16 16V448c0 8.8 7.2 16 16 16H320c8.8 0 16-7.2 16-16V128c0-8.8-7.2-16-16-16H304v24c0 13.3-10.7 24-24 24H192 104c-13.3 0-24-10.7-24-24V112H64zm128-8a24 24 0 1 0 0-48 24 24 0 1 0 0 48z" /></svg> *@
            </a>
            @if (comment.RepliesCount == 0)
            {
                <div id="replyToggle@(comment.Id)" style="visibility:hidden">
                    <a class="dropdown-toggle w-auto" data-toggle="collapse" href="#replyCollapse@(comment.Id)" role="button" aria-expanded="false" aria-controls="collapseExample">@localizer["LatestReplies"]</a>
                </div>
            }
            else
            {
                <div id="replyToggle@(comment.Id)" style="visibility:visible">
                    <a class="dropdown-toggle" style="padding: 5px 10px;" data-toggle="collapse" href="#replyCollapse@(comment.Id)" role="button" aria-expanded="false" aria-controls="collapseExample">@localizer["LatestReplies"]</a>
                </div>
            }
        </div>
        <div class="collapse" id="replyCollapse@(comment.Id)">
            <ul id="replyList@(comment.Id)" class="comments-reply">
                @foreach (var reply in comment.Replies)
                {
                    <li id="comment@(reply.Id)" class="mb-3">
                        <div class="comments-box d-flex">
                            <div class="comments-avatar">
                                <img src="@Url.Content("~" + comment.userPic)" alt="" class='rounded-circle shadow-1-strong me-3' width='65' height='65'>
                            </div>
                            <div class="comments-text">
                                <div class="avatar-name">
                                    <h5>@reply.userName <span class='small'> - @reply.CreatedDate.ToString("yyyy/MM/dd hh:mm:ss tt")</span></h5>
                                </div>

                                <p>@reply.Comment</p>
                                @if (!string.IsNullOrEmpty(reply.FilePath))
                                {
                                    <div class="attachment" style="display: flex;">
                                        <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png" alt="PDF" />
                                        <a href="@Url.Content("~/images/comments/" + reply.FilePath)" target="_blank" class="filename">@(reply.FilePath)</a>
                                    </div>
                                }
                                @if (userId == reply.userId)
                                {
                                    <a onclick='DeleteReplyUser(@reply.Id)' class='link-danger delete'>@localizer["delete"]</a>
                                    @* <form method="post" asp-action="DeleteReply" asp-route-commentId="@reply.Id" style="display:inline-block;">
                                        <button type="submit" class='btn btn-danger'>Delete</button>
                                    </form> *@
                                }
                            </div>
                        </div>
                    </li>
                }

            </ul>
            @if (Model.showReply)
            {
                <button id="MoreBtn" onclick="getReplies()" class="btn btn-link my-2">@localizer["more"]</button>
            }

        </div>

        @if (Model.showReply)
        {
            <div class='comment-box comments-reply'>
                <textarea cols="30" rows="5" wrap="hard" maxlength="500" id="reply@(comment.Id)" placeholder="@localizer["writereply"]"></textarea>

                <div class="attachment" id="file-attachment" style="display: none;">
                    <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png" alt="PDF" />
                    <span class="filename" id="file-name"></span>
                    <span class="remove-file" onclick="removeFile()">✕</span>
                </div>
                <div class="comment-footer">
                    <div>
                        <label for="comment-file" class="attach-icon">📎</label>
                        <input type="file" onchange="getFile(this)" id="comment-file" accept=".pdf" style="display: none;" />
                    </div>
                    <div>
                        <button onclick="AddReply(@comment.Id)" class="btn btn-primary">@localizer["Reply"]</button>
                    </div>
                </div>
                @* <div class='col-8'>
                    <input class='form-control' id="reply@(comment.Id)" type='text' placeholder='write reply' aria-label='Write Reply ...'>
                </div>
                <div class='col-4'>
                    <button class='btn btn-primary' onclick='AddReply(@comment.Id)'>Reply</button>
                </div> *@
            </div>
            <div id="rplyErr" class="text-danger">
            </div>
        }

        <input type="hidden" value="@Url.Action("GetComment", new { id = comment.Id })" id="CopyToClip@(comment.Id)">
    </li>
}
