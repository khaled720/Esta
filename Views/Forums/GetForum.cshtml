<hr />
<div class="news-details-area pt-50">
    <div class="container">
        <div class="row">
            <div class="col-xl-8 col-lg-12">
                    <div>
                        <h3>@Model.Title</h3>
                    </div>
                    <p>@Model.Description</p>
            </div>
        </div>
        <div class="row" style="justify-content: center;">
            <div class="col-12">
                <div class="post-comments white-bg">

                    <div class="post-comments-form my-3">
                        <div class="section-title mb-30">
                            <h2>@localizer["leaveComment"]</h2>
                        </div>
                        <div class="comment-box">
                            <textarea cols="30" rows="5" wrap="hard" maxlength="500" id="comment" placeholder="@localizer["writeComment"]"></textarea>

                            <div class="attachment" id="file-attachment" style="display: none;">
                                <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png" alt="PDF" />
                                <span class="filename" id="file-name"></span>
                                <span class="remove-file" onclick="removeFile()">✕</span>
                            </div>
                            <div class="comment-footer">
                                <div>
                                    <label for="comment-file" class="attach-icon">📎</label>
                                    <input type="file" onchange="getFile(this)" id="comment-file" accept=".pdf" style="display: none;" />
                                </div>
                                <div>
                                    <button onclick="AddComment()" class="btn btn-primary">@localizer["Comment"]</button>
                                </div>
                            </div>
                            @* <div class="col-xl-8">
                                <textarea wrap="hard" maxlength="500" name="comments" style="border-radius:10px" id="comment" cols="30" rows="5" class="form-control" placeholder="Your Comment"></textarea>
                                <button class="btn btn-primary py-3 px-5 mt-3" onclick="AddComment()">send comment</button>
                            </div> *@
                        </div>
                        <div id="cmntErr" class="text-danger">
                        </div>
                    </div>

                    <div class="latest-comments">
                        <ul id="CommentList">

                            @await Html.PartialAsync("_RenderComment", new ESTA.ViewModels.RenderComment
                            {
                                showAllLink = true,
                                showReply = false,
                                UserForums = Model.UserForum
                            })
                        </ul>
                    </div>
                    @if (ViewBag.CheckMoreComments)
                    {
                        <button id="MoreBtn" onclick="getNextPage()" class="btn btn-link my-2">@localizer["more"]</button>
                    }


                </div>
            </div>

            @*   <div class="col-xl-4 align-self-center" id="stats">
            </div>*@
        </div>
    </div>
</div>
<input type="hidden" value="@Url.Action("DeleteComment")" id="AjaxDelCmnt" />
<input type="hidden" value="@Url.Action("DeleteReply")" id="AjaxDelRpl" />
<input type="hidden" value="@Model.Id" id="ForumId" />

@section Scripts {
    <script src="~/js/forumsfuncs.js"></script>
    <script>
        var commentPage = 1;
        function getNextPage() {
            $.ajax({
                type: 'get',
                url: '@this.Url.Action("GetForumsComment", "Forums")',
                data: {
                    forumId: $('#ForumId').val(),
                    page: commentPage++
                },
                success: function (data) {
                    $('#CommentList').append(data);
                    checkMoreComments()
                },
                error: function (data) {
                    console.log(data)
                }
            });
        }
        function checkMoreComments() {
            $.ajax({
                type: 'get',
                url: '@this.Url.Action("CheckMoreComments", "Forums")',
                data: {
                    forumId: $('#ForumId').val(),
                    page: commentPage
                },
                success: function (data) {
                    if (!data)
                        $('#MoreBtn').hide();
                },
                error: function (data) {
                    console.log(data)
                }
            });
        }

        function AddComment() {
            if ($('#comment').val()) {
                $('#cmntErr').text('')
                // comment-file
                formDate = new FormData();
                var fileInput = document.getElementById("comment-file");
                var file = fileInput.files[0];
                if (file) {
                    formDate.append("file", file);
                }
                else{
                    formDate.append("file", null);
                }
                formDate.append("forumId", $('#ForumId').val());
                formDate.append("comment", $('#comment').val());

                $.ajax({
                    type: 'post',
                    url: '@this.Url.Action("AddComment", "Forums")',
                    processData: false,
                    contentType: false,
                    data: formDate,
                    success: function (data) {
                        $('#comment').val('')
                        $('#CommentList').append(data);
                        checkMoreComments()
                        removeFile()
                    },
                    error: function (data) {
                        console.log('hiii')
                    }
                });
            }
            else{
                $('#cmntErr').text('Enter valid comment')
            }
        }

        function getFile(e) {
            //debugger
            const fileAttachment = document.getElementById("file-attachment");
            const fileNameSpan = document.getElementById("file-name");
            const file = e.files[0];

            if (!file) return;

            const maxSizeKB = 512;
            const isPDF = file.name.toLowerCase().endsWith(".pdf");
            const fileSizeKB = file.size / 1024;

            if (!isPDF) {
            $('#cmntErr').text("Only PDF files are allowed.");
            e.value = "";
            return;
            }

            if (fileSizeKB > maxSizeKB) {
            $('#cmntErr').text("File size must not exceed 512 KB.");
            e.value = "";
            return;
            }

            fileNameSpan.textContent = file.name;

            // Set icon (PDF icon)
            const icon = fileAttachment.querySelector("img");
            icon.src = "https://cdn-icons-png.flaticon.com/512/337/337946.png";

            fileAttachment.style.display = "flex";
        }

        function removeFile() {
            const fileInput = document.getElementById("comment-file");
            const fileAttachment = document.getElementById("file-attachment");
            fileInput.value = "";
            fileAttachment.style.display = "none";
        }
    </script>
}
