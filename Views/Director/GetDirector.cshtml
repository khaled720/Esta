@model ESTA.Models.Director


<!-- slider-start -->
<div class="slider-area">
    <div class="page-title">
        <div class="single-slider slider-height slider-height-breadcrumb d-flex align-items-center"
             style="background-image: url(@Url.Content("~/template/img/inner-bg.png"));">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="slider-content slider-content-breadcrumb text-center">
                            <h1 class="white-color f-700">@localizer["board"]</h1>
                            <nav class="text-center" aria-label="breadcrumb">
                                <ol class="breadcrumb justify-content-center">
                                    <li class="breadcrumb-item"><a href="#" tabindex="0">@localizer["AllBoard"] </a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@localizer["board"]</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- slider-end -->

<div class="news-details-area pt-50 pb-50">
    <div class="container">

        @if (Model == null)
        {
            <p>
                @localizer["notfound"]
            </p>
        }
        else
        {
            <div class="blog-wrapper blog-list row">
                <div class="blog-thumb mb-35 col-md-4">
                    <img src="@Url.Content("~"+Model.PhotoPath)" alt="board" class="img-fluid"/>
                </div>
                <div class="blog-content news-content col-md-8">
                    @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                    {
                        <h4>@Model.NameAr</h4>
                        <h5>@Model.JobAr</h5>
                        <p>
                            @Html.Raw(Model.BioAr)
                        </p>
                    }
                    else
                    {
                        <h4>@Model.NameEn</h4>
                        <h5>@Model.JobEn</h5>
                        <p>
                            @Html.Raw(Model.BioEn)
                        </p>
                    }

                </div>
            </div>

        }
    </div>
</div>