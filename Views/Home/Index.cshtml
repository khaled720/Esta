@using Microsoft.Extensions.Localization
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "Home Page";
}

@model ESTA.ViewModels.HomeIndexViewModel
@inject IStringLocalizer<ESTA.SharedResource> localizer;

<style>
    .card {
        transition: 0.5s ease-in-out;
        overflow: hidden;
        /*z-index:10;*/
    }

    #courses-calendar {
        max-width: 1300px;
        margin: 0 auto;
        background-color: white;
        border-radius: 10px;
        padding: 3px;
    }
</style>

<link href="~/css/ticker.css" rel="stylesheet" />
<!-- slider-start -->
<div class="slider-area pos-relative">
    <div class="slider-active">

        @foreach (var banner in Model.BannerList)
        {

            @if (banner.FilePath.Split('.')[1] == "mp4")
            {
                <div class="single-slider slider-height slider-height-3 d-flex align-items-center justify-content-center">

                    <div id="video-div" style="height:500px;">

                        <video width="100%" loop muted autoplay playsinline>
                            <source src="@Url.Content("~/Images/Banners/" + banner.FilePath)" type="video/mp4" />
                            Your browser does not support HTML video.
                        </video>

                    </div>
                    <div class="container top-mob" style="position:absolute">
                        <div class="row  justify-content-center" style="z-index:999999">
                            <div class="">
                                <div class="slider-content slider-content-2 slider-content-3 text-center">
                                    <a asp-action="About" asp-controller="Home" asp-area="" asp-route-type="about">
                                        <h1 class="white-color f-700" data-animation="fade-up" data-delay=".2s">@banner.Title</h1>
                                        <p data-animation="fade-up" data-delay=".4s">@banner.Details</p>
                                    </a>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
            else
            {
                <div class="single-slider slider-height slider-height-3 d-flex align-items-center justify-content-center" style="background-image: url(@Url.Content("~/Images/Banners/" + banner.FilePath))">
                    <div class="container">
                        <div class="row  justify-content-center">
                            <div class="">
                                <div class="slider-content slider-content-2 slider-content-3 text-center">
                                    <a asp-action="Register" asp-controller="Account" asp-area="">
                                        <h1 class="white-color f-700" data-animation="fade-up" data-delay=".2s">@banner.Title </h1>
                                        <p data-animation="fade-up" data-delay=".4s">@banner.Details</p>
                                        @* <p data-animation="fade-up" data-delay=".4s">   @localizer["wel2desc"]                  </p> *@
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        }
