<!-- about start -->
<div id="about" class="about-area pt-80 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-xl-7 col-lg-7">
                <div class="about-title-section mb-30 aos-init  aos-animate" data-aos="flip-up" data-aos-duration="1200">
                    <h1>@localizer["about"] ESTA</h1>
                    <h5>@localizer["esta"] ESTA</h5>
                    <p>


                        @Model.About



                    </p>

                    <a class="theme-btn blue-bg-border mt-20" asp-action="About" asp-controller="Home" asp-route-type="about"><span class="btn-text">@localizer["readmore"]</span></a>

                    <!--<button class="theme-btn blue-bg-border mt-20"><span class="btn-text">Read More</span></button>-->
                </div>
            </div>
            <div class="col-xl-5 col-lg-5 aos-init aos-animate" data-aos="flip-down" data-aos-duration="1200">
                <div class="about-right-img mb-30">
                    <img src="@Url.Content("~/template/img/about/about-right.png")" alt="">
                </div>
            </div>
        </div>

    </div>
</div>
<!-- about end -->
<!-- latest_news start -->
@await Component.InvokeAsync("Events")
<!-- latest_news end -->
<!-- courses start -->
@if (Model.UpcomingCourse != null)
{
    <div class="latest_news-area pt-70 pb-70">
        <div class="container">
            <div class="row">
                <div class="col-12 aos-init aos-animate" data-aos="fade-up"
                     data-aos-anchor-placement="center-center" data-aos-duration="1000">
                    <div class="section-title mb-50 text-center">
                        <div class="section-title-heading mb-20">
                            <h1 class="primary-color">@localizer["upcourses"]</h1>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var item in Model.UpcomingCourse)
                {
                    <div class="col-xl-4 col-lg-4 col-md-6 aos-init aos-animate" data-aos="zoom-in-up" data-aos-duration="1500">
                        <div class="courses-wrapper courses-wrapper-3 mb-30">
                            <div class="courses-thumb">
                                <a asp-action="coursedetails" asp-controller="courses" asp-route-id="@item.Id"><img src="@Url.Content("~" + @item.PhotoPath) " alt=""></a>
                            </div>
                            <div class="courses-content courses-content-3 clearfix">
                                <div class="courses-heading mt-25 d-flex">
                                    <div class="course-title-3">
                                        <h1>
                                            <a asp-action="coursedetails" asp-controller="courses" asp-route-id="@item.Id">

                                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                                {
                                                    @item.TitleAr
                                                }
                                                else
                                                {
                                                    @item.Title
                                                }

                                            </a>
                                        </h1>
                                    </div>
                                    @* <div class="courses-pricing-3">
                                <span>
                                    @if (item.Price <= 0)
                                    {
                                        @localizer["free"]
                                    }
                                    else
                                    {
                                        @item.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))

                                    }
                                </span>
                            </div> *@
                                </div>
                                <div class="courses-para mt-15">

                                    @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                    {
                                        @if (item.DescriptionAr.Count() > 45)
                                        {
                                            <p>@item.DescriptionAr.Substring(0, 45) ..</p>
                                        }
                                        else
                                        {
                                            <p>@item.DescriptionAr</p>
                                        }
                                    }
                                    else
                                    {
                                        @if (item.Description.Count() > 45)
                                        {
                                            <p>@item.Description.Substring(0, 45) ..</p>
                                        }
                                        else
                                        {
                                            <p>@item.Description</p>
                                        }
                                    }
                                </div>
                                <div class="course-date mt-15">
                                    <span class="course-date-icon ti-calendar"></span>
                                    <span class="start-date-text">@localizer["stdate"] </span>
                                    <span>@item.StartDate.Value.ToString("yyyy/MM/dd")</span>
                                </div>
                                <div class="courses-wrapper-bottom clearfix mt-35">
                                    <div class="courses-button">
                                        <a asp-action="coursedetails" asp-controller="courses" asp-route-id="@item.Id">@localizer["details"]</a>


                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
}

<!-- courses end -->
<!-- choose start -->
<div id="upComingCourses" class="gray-bg pt-70 pb-20 ">
    <div class="container">
        <div class="row">
            <div class="col-12  aos-init aos-animate" data-aos="fade-up"
                 data-aos-anchor-placement="center-center" data-aos-duration="1000">
                <div class="section-title mb-50 text-center">
                    <div class="section-title-heading mb-20">
                        <h1 class="primary-color">@localizer["whyus"]</h1>
                    </div>

                </div>
            </div>
        </div>
        <div class="row missionVissonRow">
            <div class="col-md-5 mb-5 aos-init aos-animate" data-aos="zoom-in-up" data-aos-duration="1500">
                <div class="choose_box">

                    <div><img src=" @Url.Content("~/template/img/vission_trans.png") " alt="#" /><h3>@localizer["ourvission"]</h3></div>

                    <p> @Html.Raw(Model.Vission) ...</p>

                    <a class="vissionMissionBtn theme-btn blue-bg-border mt-10" asp-action="About" asp-route-type="vission"
                       asp-controller="Home"><span class="btn-text">@localizer["readmore"]</span></a>
                </div>
            </div>
            <div class="col-md-5 mb-5 aos-init aos-animate" data-aos="zoom-in-up" data-aos-duration="1500">
                <div class="choose_box">
                    <div><img src="@Url.Content("~/template/img/mission_trans.png") " alt="#" /><h3>@localizer["ourmission"]</h3></div>

                    <p>@Html.Raw(Model.Mission) ...</p>
                    <a class="vissionMissionBtn theme-btn blue-bg-border mt-10" asp-action="About" asp-route-type="mission"
                       asp-controller="Home"><span class="btn-text">@localizer["readmore"]</span></a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- choose end -->
<!-- calendar start -->
<div id="choose" class="pt-100 pb-50" style="background-image: url(@Url.Content("~/template/img/shop_bg.jpg"))">
    <div class="container">
        <div class="row">
            <div class=" col-12 aos-init aos-animate" data-aos="fade-up"
                 data-aos-anchor-placement="center-center" data-aos-duration="1000">
                <div class="section-title mb-50 text-center">
                    <div class="section-title-heading mb-20">
                        <h1 class="white-color">@localizer["upcourses_events"]</h1>
                    </div>

                </div>
            </div>
        </div>

        <div class="events-list mb-30">
            <div class="row" style="justify-content:center">
                <div class="col-lg-10 aos-init aos-animate" data-aos="fade-down"
                     data-aos-duration="1500">

                    <div id="courses-calendar"></div>

                </div>

            </div>
        </div>

    </div>
</div>
<!-- calendar end -->
<!-- image ticker start -->
<div class="image-tickerDIV">
    <div class="image-ticker">
        <ul>
            @foreach (var item in Model.LogosList)
            {
                <li>
                    <img src="@Url.Content("~/images/Logos/" + item.ImagePath)">
                </li>
            }
        </ul>
    </div>
</div>
<!-- image ticker end -->
<input type="hidden" value="@Url.Action("GetEvents")" id="AjaxUrl" />

<input type="hidden" value="@Url.Action("GetEvent", "EventsNews")" id="GetEventUrl" />

<input type="hidden" value="@Url.Action("Courses", "api")" id="GetCourseUrl" />

<input type="hidden" value="@Url.Action("CourseDetails", "Courses")" id="GetCoursedetails" />

