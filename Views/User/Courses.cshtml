@using System.Globalization
@using ESTA.Helpers
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

}
@model IEnumerable<UserCourse>



<br />


<div class="container">
    @if (Model.Count() == 0)
    {
        <h3 class="text-danger "> You Haven't Enrolled Any Courses Yet.</h3>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />
    }
    else
    {
        <h3 class="">My Courses</h3>
        <div id="courses-grid" style="display:grid;gap:15px; grid-template-columns:1fr 1fr 1fr 1fr">

            @foreach (var item in Model)
            {

                <div class="card" style="height:fit-content; position:relative">
                    @*  <a href="home/coursedetails/@item.course.Id" class="btn btn-primary"  style="position:absolute;bottom:5px;right:5px">More</a>
            *@   <div class="card-header" style="
position:absolute;top:0;left:0;right:0;

background: rgba(100%,100%,100%,50%);
    backdrop-filter: blur(5px);">
                        <h5>
                            @item.course.Title

                        </h5>
                    </div>
                    <img src="@item.course.PhotoPath" height="200px" />


                    <div class="card-body">
                        Starting Date:    @item.course.StartDate.Value.ToShortDateString()
                        Enrollment Date:    @item.EnrollmentDate.ToShortDateString()

                        <br> Price: <strong style="color:green"> @item.course.Price.ToString("c", CultureInfo.GetCultureInfo(Constants.PriceCulture))</strong>

                        <br> State: <strong style="color:green"> @item.state.StateName</strong>
                        <br>Payment State:
                        @if (item.isPaid)
                        {
                            <strong style="color:green"> Done </strong>
                        }
                        else
                        {

                            <strong style="color:green"> Pending </strong>
                        }


                    </div>
                </div>
            }











        </div>
    }

</div>







<style>
    .card {
        transition: 0.5s ease-in-out;
        overflow: hidden;
        /*z-index:10;
            */
    }

        .card:hover {
            transform: scale(1.1,1.1)
        }

</style>