@model object


<div class=" container" style="padding:50px">

    <div id="embed-target"></div>
    @* @Model.ToString()*@

    <br />


    @*    <%-- <input type="button" value="Pay with Embedded Page" onclick="Checkout.showEmbeddedPage('#embed-target');" />--%>*@



    <div class="row justify-content-center">

        <h3 class="col-12">@localizer["refundpolicy"]</h3>

        <div class="col-12">
            @Html.Raw(@localizer["payinfo"])

            <a target="_blank" asp-area="" asp-action="terms" asp-controller="Home">@localizer["termsCon"]</a>
            .
            <a target="_blank" asp-area="" asp-action="privacy" asp-controller="Home">@localizer["pp"]</a>
        </div>

        <div class="col-12 chk-ar" style="margin:25px;">

            <label>
                <input id="agree-chkbox" onchange="checkAgree()" style="width:15px" type="checkbox" />
                @localizer["agreepolicy"]
            </label>

        </div>
    </div>
    <div class="row justify-content-center">

        <div class="col-12" style=" margin:25px 0px;display:flex;justify-content:center; height:40px;gap: 5px;">
            <img src="@Url.Content("~/images/payment/qnb alahli logo.png")" />
            <img src="@Url.Content("~/images/payment/mastercard acceptance sign.png")" />
            <img src="@Url.Content("~/images/payment/meeza_cards_logo.png")" />
            <img src="@Url.Content("~/images/payment/visa acceptance sign.png")" />
        </div>


        <input class="btn col-8 btn-primary" id="movePaymentBtn" disabled type="button" value="@localizer["movetopay"]" onclick="Checkout.showPaymentPage();" />


    </div>
    <br />
    <br />
    <br />
    <br />

</div>
<script src="~/js/move-to-payment.js"></script>
<script src="https://qnbalahli.gateway.mastercard.com/static/checkout/checkout.min.js"
        data-error="errorCallback"
        data-cancel="cancelCallback">
</script>
<script type="text/javascript">
    function errorCallback(error) { console.log(JSON.stringify(error)); }
    function cancelCallback() { console.log('Payment cancelled'); }
</script>

<script>
    Checkout.configure({ session: { id: "@Model.ToString()" } });
    debugger;
</script>