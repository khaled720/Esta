@model GlobalConstants


@{

    Layout = "_AdminLayout";

}

<div class="page-head">
    <h2>@localizer["membership"]</h2>
    <h5>@localizer["edit"]</h5>
</div>

<form method="post" action="EditMempership" class="rounded-div">
    @Html.HiddenFor(y => y.Id)
    <div class="row">

        <div class=" col-6">

            <label asp-for="@Model.MempershipFee"></label>
            <input asp-for="@Model.MempershipFee" class="form-control" />
            <span asp-validation-for="@Model.MempershipFee"></span>

        </div>


        <div class=" col-6">

            <label asp-for="@Model.MempershipExpiryMonth"></label>
            <input type="number"
                   asp-for="@Model.MempershipExpiryMonth"
                   class="form-control" />
            <span asp-validation-for="@Model.MempershipExpiryMonth"></span>
        </div>

        <div class=" col-6">

            <label asp-for="@Model.RenewalFee"></label>
            <input asp-for="@Model.RenewalFee"
                   class="form-control" />
            <span asp-validation-for="@Model.RenewalFee"></span>
        </div>

        <div class=" col-6">

            <label asp-for="@Model.LatePenalty"></label>
            <input asp-for="@Model.LatePenalty"
                   class="form-control" />
            <span asp-validation-for="@Model.LatePenalty"></span>
        </div>

        <div class=" col-6">

            <label asp-for="@Model.PenaltyMonth"></label>
            <input type="date"
                   asp-for="@Model.PenaltyMonth"
                   value="@Model.PenaltyMonth.ToString("yyyy-MM-dd")"
                   class="form-control" />
            <span asp-validation-for="@Model.PenaltyMonth"></span>
        </div>

        <div class=" col-6">

            <label asp-for="@Model.NewMempershipFee"></label>
            <input asp-for="@Model.NewMempershipFee"
                   class="form-control" />
            <span asp-validation-for="@Model.NewMempershipFee"></span>
        </div>



    </div>
    <br />

    <br />

    <button type="submit" class="btn-primary btn">@localizer["submit"]</button>
</form>
