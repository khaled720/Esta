@{
}
@model ESTA.Areas.Admin.ViewModels.LogosVM;
<style>
    .file-upload {
        background-color: #ffffff;
        width: 60%;
        margin: 0 auto;
        padding: 20px;
    }

    .file-upload-input {
        position: absolute;
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        outline: none;
        opacity: 0;
        cursor: pointer;
    }

    .image-upload-wrap {
        margin-top: 20px;
        border: 2px dashed black;
        position: relative;
    }

        .image-dropping,
        .image-upload-wrap:hover {
            /*background-color: antiquewhite;*/
            border: 2px dashed black;
        }

    .image-title-wrap {
        padding: 0 15px 15px 15px;
        color: black;
    }

    .drag-text {
        text-align: center;
    }

        .drag-text h3 {
            font-weight: 100;
            text-transform: uppercase;
            color: black;
            padding: 60px 0;
        }
</style>
<form asp-action="UploadLogo" method="post" class="row gy-3" enctype="multipart/form-data">

    @if (ViewBag.Edit != null)
    {
        if (ViewBag.Edit)
        {
            <div class="alert alert-success" role="alert" id="alert">
                @localizer["success"]
            </div>
        }
        else if (!ViewBag.Edit)
        {
            <div class="alert alert-danger" role="alert" id="alert">
                @localizer["failure"]
            </div>
        }
    }

    <div class="file-upload mb-3">
        <div class="image-upload-wrap">
            <input asp-for="ImageFile" class="file-upload-input" id="img" accept="image/jpeg, image/png" type='file' onchange="readURL(this);" />

            <img class="img-fluid" id="imgSrc" src="#" alt="your image" style="display:none;" />
            <div class="drag-text">
                <h3>@localizer["imgclick"]</h3>
            </div>

        </div>
    </div>
    <div class="col-12 mt-3">
        <button type="submit" class="btn-primary btn">@localizer["submit"]</button>
    </div>

</form>
<div id="logos">
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_validationscriptspartial.cshtml");
    }
    <script>

        $(document).ready(function () {
            setTimeout(() => { $('#alert').css('display', 'none') }, 10000)

            $.ajax({
                url: '@Url.Action("GetLogos", "Logos", new { area = "Admin" })',
                type: 'GET',
                success: function (data) {
                    $('#logos').html(data);
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching logos:', error);
                }
            });
        });
        function readURL(input) {
            if (input.files && input.files[0]) {
                var formData = new FormData();
                const url = URL.createObjectURL(input.files[0]);
                //var extension = input.files[0].split('.')[1];

                $('#imgSrc').attr('src', url);
                $('#imgSrc').css('display', 'block');

                $('.drag-text').hide();
            }
        }
    </script>
}