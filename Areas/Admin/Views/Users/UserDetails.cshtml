@using ESTA.ViewModels
@model ESTA.Models.User

@{
    ViewData["Title"] = "UserDetails";
}

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>


<h2>
    @Model.FullName @Html.ActionLink(@localizer["delete"], "DeleteUser", new { userId =Model.Id }, new { @class = "btn btn-danger"  ,@onclick = "return confirm('Are you sure you wish to delete this user?');"} )


</h2>

@if (!ViewBag.isCertified)
{

    <form method="POST" asp-action="Add" asp-controller="CertifiedMembers"
          asp-area="Admin" asp-route-name="@Model.FullName">
        <button type="submit" class="btn btn-primary">@localizer["markascert"]</button>

    </form>

}




<div>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <ul class="nav nav-tabs">

        <li class="active"><a data-toggle="tab" href="#menu">@localizer["personalinfo"]</a></li>

        <li><a data-toggle="tab" href="#menu1">@localizer["addressinfo"]</a></li>

        <li><a data-toggle="tab" href="#menu2">@localizer["workinfo"]</a></li>

        <li><a data-toggle="tab" href="#menu3">@localizer["eduinfo"]</a></li>

        <li><a data-toggle="tab" href="#menu4">@localizer["regCourses"]</a></li>

        <li><a data-toggle="tab" href="#menu5">@localizer["usersAnswers"]</a></li>

    </ul>

    <div class="tab-content">
        <div id="menu" class="tab-pane fade in active">


            @{


                var mapped = mapper.Map<User, EditUserPersonalInfoViewModel>(Model);

                <partial name="_EditUserPersonalInfo" model="mapped"></partial>


            }


        </div>

        <div id="menu1" class="tab-pane fade">

            @{
                var mapped2 = mapper.Map<User, EditUserAddressInfoViewModel>(Model);


                <partial name="_EditUserAddressInfo" model="mapped2"></partial>


            }

        </div>

        <div id="menu2" class="tab-pane fade">

            @{
                var mapped3 = mapper.Map<User, EditUserWorkInfoViewModel>(Model);


                <partial name="_EditUserWorkInfo" model="mapped3"></partial>


            }

        </div>

        <div id="menu3" class="tab-pane fade">


            @{
                var mapped4 = mapper.Map<User, EditUserEducationInfoViewModel>(Model);


                <partial name="_EditUserEducationInfo" model="mapped4"></partial>



            }


        </div>
        
        <div id="menu4" class="tab-pane fade">
            <br>
            @{

                @await Component.InvokeAsync("UserCourses",new {userId=@Model.Id })

            }

        </div>

        <div id="menu5" class="tab-pane fade">

            @if (Model.userAnswers != null && Model.userAnswers.Count() > 0)
            {
                foreach (var x in Model.userAnswers)
                {
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action" aria-current="true">
                            <div class="d-flex w-100 justify-content-between">
                                @if (Thread.CurrentThread.CurrentCulture.Name == "ar")
                                {
                                    <h5 class="mb-1 text-bold">@x.question.QuestionArtxt</h5>
                                }
                                else
                                {
                                    <h5 class="mb-1 text-bold">@x.question.QuestionEntxt</h5>
                                }
                            </div>
                            <p class="mb-1 text-info">@x.Answer</p>
                        </a>
                    </div>
                }
            }

        </div>
    </div>
</div>

<br />

<span>

    <a asp-action="Index" class="btn btn-success">Back</a>
</span>

<br />
<br />

