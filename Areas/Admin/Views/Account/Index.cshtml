@{
}
@using ESTA.Areas.Admin.ViewModels;
@model List<ViewAdmins>


<div style="display:flex;justify-content:space-between;align-items:center">
    <h2>@localizer["Admins"]</h2>

    @Html.ActionLink(localizer["createadmin"], "CreateAdmin", new { }, new { @class = "btn btn-primary" })
</div>

<div class="rounded-div">
    <table id="courses-table" class="table table-striped animate__fadeIn " style="animation-duration:1s">
        <thead>
            <tr>
                <th>@localizer["username"]</th>
                <th>@localizer["UserRole"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>

            @{
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Roles</td>
                        <td>
                            @Html.ActionLink(localizer["edit"], "EditUser", new { userId = item.Id },
                                 new { @class = "btn btn-success" })
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#courses-table').DataTable({
                "bDestroy": true,
                "bSearchable": true,
                "responsive": true,
                // "columns": [
                //     { "orderable": "true" },
                //     { "orderable": "true" },
                //     { "orderable": "true" },
                //     { "orderable": "false" },
                //     { "orderable": "false" },
                //     { "orderable": "false" },
                //     { "orderable": "false" },
                //     { "orderable": "false" },
                // ]
            });
            //$('#courses-table').dataTable();
        });
    </script>

}