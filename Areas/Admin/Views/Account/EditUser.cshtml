@using ESTA.Resources;
@model ESTA.ViewModels.EditUser;

<style>
    .form-label {
        top: -15px !important;
        color: blueviolet;
    }

</style>

<div class="container">

    <form asp-action="EditUser" method="post" class="row gy-3">
        <div asp-validation-summary="All" id="Validation" class="text-danger">
        </div>
        <input asp-for="Id" value="@Model.Id" type="hidden"/>
        <div class="col-12">
            <label class="form-label">@localizer["UserRole"]</label>
            <select class="form-select select2" asp-for="RoleId" id="Roles" asp-items="@ViewBag.roleList" multiple="multiple">
            </select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="col-12" id="Divbtn">
            <button class="btn btn-primary">@localizer["submit"]</button>
        </div>

    </form>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            $('.select2').select2();
        });

    </script>
    @{
        await Html.RenderPartialAsync("_validationscriptspartial.cshtml");
    }

}