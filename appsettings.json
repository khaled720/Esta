  "Serilog": {
    "Using": [ "Serilog.Expressions", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Fatal",
        "Microsoft": "Fatal",
        "Microsoft.Hosting": "Fatal",
        "Microsoft.AspNetCore": "Fatal",
        "Microsoft.Hosting.Lifetime": "Fatal",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l = 'Information'"
                }
              },
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "StartsWith(@m, 'HTTP')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "Esta_log/ActionsLog/Info-.txt",
                  "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact",
                  "rollOnFileSizeLimit": true,
                  "rollingInterval": "Day",
                  "outputTemplate": "{NewLine}[{Timestamp:yyyy-MM-dd HH:mm:ss.sss} {Level:u3}] {Message:lj}"
                }

              }
            ]
          }
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Esta_log/ErrorLog/Error-.txt",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact",
          "restrictedToMinimumLevel": "Error",
          "rollOnFileSizeLimit": true,
          "rollingInterval": "Day",
          "outputTemplate": "{NewLine}[{Timestamp:yyyy-MM-dd HH:mm:ss.sss} {Level:u3}] {Message:lj}{Properties}{Exception}"
        }
      }
    ]
  }
}
